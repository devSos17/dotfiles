#!/bin/bash
# lights: apaga/prende luces RGB (ASUS Aura via liquidctl) y monitores (hyprctl dpms).
# Uso: lights off|on|toggle|status
# Funciona desde ssh (busca la instancia de Hyprland sola).
# Restore automatico: tras suspend/hibernate -> ~/.config/systemd/user/lights-resume.service;
# al boot -> hl.on("hyprland.start") en hypr/lua/autostart.lua;
# tras `off` -> waiter (unit lights-wake) que bloquea hasta el 1er evento de raton/teclado.

# Modo "prendido" del RGB (liquidctl set sync color <modo> <color>)
RGB_MODE="${RGB_MODE:-static}"
RGB_COLOR="${RGB_COLOR:-80ff00}"

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/lights.off"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

hypr() {
    if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        local d
        for d in "$XDG_RUNTIME_DIR"/hypr/*/; do
            [ -S "$d/.socket.sock" ] || continue
            export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$d")"
        done
    fi
    [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || { echo "hyprland: no hay instancia" >&2; return 1; }
    hyprctl "$@"
}

rgb() {  # rgb off | rgb on   (reintenta: tras resume el USB tarda en volver)
    local i args
    if [ "$1" = on ]; then args=(set sync color "$RGB_MODE" "$RGB_COLOR"); else args=(set sync color off); fi
    for i in 1 2 3 4 5; do
        liquidctl --match aura "${args[@]}" 2>/dev/null && return 0
        sleep 1
    done
    echo "liquidctl: no se pudo ($1)" >&2; return 1
}

WAKE_UNIT=lights-wake

cancel_wake() {
    [ -n "$LIGHTS_NOCANCEL" ] && return 0
    systemctl --user stop "$WAKE_UNIT" 2>/dev/null || true
}

arm_wake() {  # waiter desacoplado (sobrevive a ssh/terminal); sin polling
    cancel_wake
    systemd-run --user --quiet --collect --unit="$WAKE_UNIT" "$(readlink -f "$0")" _wait
}

wait_input() {  # bloquea hasta el primer evento de raton/teclado, luego lights on
    local devs=() d
    if [ -n "$LIGHTS_WAIT_DEVS" ]; then
        read -ra devs <<<"$LIGHTS_WAIT_DEVS"
    else
        devs=(/dev/input/mice /dev/input/by-id/*-event-kbd)
    fi
    sleep 1   # que la tecla que lanzo `off` (y su release) no despierte
    for d in "${devs[@]}"; do
        # evdev (event*) rechaza lecturas menores a un input_event (24 B en x86_64) con EINVAL
        [ -r "$d" ] && { head -c24 "$d" >/dev/null & }
    done
    wait -n
    kill $(jobs -p) 2>/dev/null
    LIGHTS_NOCANCEL=1 exec "$(readlink -f "$0")" on
}

case "${1:-toggle}" in
    _wait)
        wait_input
        ;;
    off)
        rgb off
        hypr dispatch 'hl.dsp.dpms({action = "off"})' >/dev/null
        mkdir -p "$(dirname "$STATE")"; touch "$STATE"
        arm_wake
        ;;
    on)
        cancel_wake
        rgb on
        hypr dispatch 'hl.dsp.dpms({action = "on"})' >/dev/null
        rm -f "$STATE"
        ;;
    toggle)
        if [ -f "$STATE" ]; then "$0" on; else "$0" off; fi
        ;;
    status)
        if [ -f "$STATE" ]; then echo off; else echo on; fi
        ;;
    *)
        echo "uso: lights off|on|toggle|status" >&2; exit 2
        ;;
esac
