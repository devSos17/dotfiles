# Cursor
# El tema se llama `breeze_cursors` (paquete breeze-cursors). "Breeze" no existe
# como tema de cursor -> hyprcursor fallaba y caia a Xcursor con cientos de warns.
env = XCURSOR_SIZE,24
env = XCURSOR_THEME,breeze_cursors
env = HYPRCURSOR_THEME,breeze_cursors
env = HYPRCURSOR_SIZE,24

# Toolkit backends
env = GDK_BACKEND,wayland
env = QT_QPA_PLATFORMTHEME,qt6ct
env = ELECTRON_OZONE_PLATFORM_HINT,wayland

# GTK theme is set via import_gtk.sh script

# ─── GPU device order ────────────────────────────────────────────────────
# Fuente: .chezmoidata/gpu.yaml
# Se emiten rutas PCI estables; cardN cambia entre boots segun orden de probe.
# `stat` se evalua en la maquina destino: si una ruta no existe, se omite,
# asi que un dato desactualizado degrada en vez de romper Hyprland.
{{- $gpu := (index .gpu .chezmoi.hostname) | default dict }}
{{- $devs := list }}
{{- range ($gpu.order | default list) }}
{{-   $path := printf "/dev/dri/by-path/%s-card" . }}
{{-   if stat $path }}{{ $devs = append $devs $path }}{{ end }}
{{- end }}
{{- if $devs }}
env = WLR_DRM_DEVICES,{{ join ":" $devs }}
{{- else }}
# Sin rutas PCI validas para {{ .chezmoi.hostname }} - Hyprland autodetecta.
# Revisar .chezmoidata/gpu.yaml contra `ls -l /dev/dri/by-path/`.
{{- end }}

{{ if eq .chezmoi.hostname "ronin" }}
# nVidia Fixes
env = LIBVA_DRIVER_NAME,nvidia
env = NVD_BACKEND,direct
env = XDG_SESSION_TYPE,wayland
env = WLR_NO_HARDWARE_CURSORS,1

# THis are to setup GBM ; Nvidias proprietary shit
env = GBM_BACKEND,nvidia-drm
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = MOZ_DISABLE_RDD_SANDBOX,1
{{ end }}
{{ if eq .chezmoi.hostname "abyss" }}
# AMD GPU hardware acceleration
env = LIBVA_DRIVER_NAME,radeonsi
{{ end }}
