-- Reglas de Workspace-a-Monitor
-- Origen: dot_config/hypr/conf/workspace.conf.tmpl

{{ if or (eq .chezmoi.hostname "abyss") (eq .chezmoi.hostname "ronin") -}}
-- Setup del escritorio (abyss siempre; ronin cuando esta en el dock).
-- En ronin sin dock, los workspaces vuelven a eDP-1 automaticamente.
local UW   = "desc:LG Electronics LG ULTRAWIDE 509NTQDPS052"
local LEFT = "desc:BNQ BenQ EX240N ET65R00479SL0"
local RIGHT = "desc:Dell Inc. DELL P2314H 08MT558203AB"

local layout = {
  -- UW (LG Ultrawide) - principales
  { 1, UW, true }, { 2, UW }, { 4, UW }, { 7, UW }, { 8, UW },
  -- Dell (derecha) - 3 y 5 viven aqui por default + 14-18
  { 3, RIGHT }, { 5, RIGHT },
  { 14, RIGHT, true }, { 15, RIGHT }, { 16, RIGHT }, { 17, RIGHT }, { 18, RIGHT },
  -- BenQ (izquierda) - 6 vive aqui por default + 9-13
  { 6, LEFT },
  { 9, LEFT, true }, { 10, LEFT }, { 11, LEFT }, { 12, LEFT }, { 13, LEFT },
}

for _, r in ipairs(layout) do
  hl.workspace_rule({ workspace = tostring(r[1]), monitor = r[2], default = r[3] or nil })
end
{{ end -}}
