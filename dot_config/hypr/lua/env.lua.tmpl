-- Variables de entorno
-- Origen: dot_config/hypr/conf/env.conf.tmpl

-- Cursor
-- El tema se llama `breeze_cursors` (paquete breeze-cursors). "Breeze" no
-- existe como tema de cursor -> hyprcursor fallaba y caia a Xcursor con
-- cientos de warnings (confirmado en vivo en el test de nested Hyprland).
-- Alineado con dot_config/hypr/conf/env.conf.tmpl (commit 97ac2ee).
hl.env("XCURSOR_SIZE", "24")
hl.env("XCURSOR_THEME", "breeze_cursors")
hl.env("HYPRCURSOR_THEME", "breeze_cursors")
hl.env("HYPRCURSOR_SIZE", "24")

-- Backends de toolkit
hl.env("GDK_BACKEND", "wayland")
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "wayland")

-- El tema GTK se setea via el script import_gtk.sh (ver lua/autostart.lua)

-- ─── Orden de dispositivos GPU (WLR_DRM_DEVICES) ──────────────────────────
-- Fuente: .chezmoidata/gpu.yaml (misma logica que dot_config/hypr/conf/env.conf.tmpl,
-- commit 7246ddc). Rutas PCI estables en vez de cardN: cardN lo asigna el
-- kernel en orden de probe y CAMBIA entre boots.
-- `stat` se evalua en la maquina destino: si una ruta no existe, se omite,
-- asi que un dato desactualizado degrada a autodetect en vez de romper Hyprland.
{{- $gpu := (index .gpu .chezmoi.hostname) | default dict }}
{{- $devs := list }}
{{- range ($gpu.order | default list) }}
{{-   $path := printf "/dev/dri/by-path/%s-card" . }}
{{-   if stat $path }}{{ $devs = append $devs $path }}{{ end }}
{{- end }}
{{- if $devs }}
hl.env("WLR_DRM_DEVICES", "{{ join ":" $devs }}")
{{- else }}
-- Sin rutas PCI validas para {{ .chezmoi.hostname }} - Hyprland autodetecta.
-- Revisar .chezmoidata/gpu.yaml contra `ls -l /dev/dri/by-path/`.
{{- end }}

{{ if eq .chezmoi.hostname "ronin" }}
-- Fixes nVidia
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("NVD_BACKEND", "direct")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("WLR_NO_HARDWARE_CURSORS", "1")

-- Setup de GBM; propietario de Nvidia
hl.env("GBM_BACKEND", "nvidia-drm")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("MOZ_DISABLE_RDD_SANDBOX", "1")
{{ end }}
{{ if eq .chezmoi.hostname "abyss" }}
-- Aceleracion de hardware AMD GPU
hl.env("LIBVA_DRIVER_NAME", "radeonsi")
{{ end }}
