# Carga de secretos del vault (solo login shell)
# Definiciones: ~/.config/secrets/{service} — formato: ENV_VAR item [field]
# Helpers: ~/.config/shell/lib/bw-helpers.sh (rbw-first, fallback a bw)
#
# NUNCA pregunta contrasena aqui: un pinentry bloqueando el login seria
# insufrible. Solo carga si el vault YA esta abierto (con rbw eso pasa
# cuando el agente sigue vivo dentro de lock_timeout, p.ej. al reconectar
# por ssh). Si esta cerrado, no hace nada: usa `bw-load` o prefix+b.

# Salida rapida: si ya estan en el env global de tmux, no toques el vault.
# El hook `pre/environment` los jala a este shell desde ahi.
if command -v tmux >/dev/null 2>&1 && tmux showenv -g SECRETS_LOADED >/dev/null 2>&1; then
    return 0 2>/dev/null || true
fi

_secrets_try_load() {
    local helpers="$HOME/.config/shell/lib/bw-helpers.sh"
    [ -f "$helpers" ] || return 1
    . "$helpers"

    [ -n "$(vault_client)" ] || return 1
    # vault_unlocked no dispara pinentry: solo consulta estado.
    vault_unlocked || return 1

    load_secrets
}

_secrets_try_load
unset -f _secrets_try_load
