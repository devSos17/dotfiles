# auto init via sesh (skip in SSH sessions and embedded IDE terminals)
if [ -x "$(command -v sesh)" ] \
    && [ -z "${TMUX}" ] \
    && [ -z "${SSH_CLIENT}" ] \
    && [ -z "${SSH_TTY}" ] \
    && [ "${TERM_PROGRAM}" != "kiro" ] \
    && [ "${TERM_PROGRAM}" != "vscode" ]; then
    sesh connect main 2>/dev/null || exec sesh connect main
fi
