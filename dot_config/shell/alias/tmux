# auto init via sesh (skip in SSH sessions and embedded IDE terminals)
if [ -x "$(command -v sesh)" ] \
    && [ -z "${TMUX}" ] \
    && [ -z "${SSH_CLIENT}" ] \
    && [ -z "${SSH_TTY}" ] \
    && [ "${TERM_PROGRAM}" != "kiro" ] \
    && [ "${TERM_PROGRAM}" != "vscode" ]; then
    # Single invocation: the old `... 2>/dev/null || exec ...` ran sesh twice on
    # failure (once silenced, once exec'd) just to surface the error. Let sesh
    # print its own error and fall through to a plain shell instead.
    sesh connect main || echo "sesh: could not attach to 'main' — continuing in plain shell"
fi
