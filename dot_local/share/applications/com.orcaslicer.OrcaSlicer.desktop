[Desktop Entry]
Name=OrcaSlicer
GenericName=3D Printing Software
Comment=3D printer slicer
Icon=OrcaSlicer
# FONTCONFIG_FILE: workaround for the bundled static FreeType segfaulting on
# variable fonts (cairo/pango crash right after the splash screen).
Exec=env FONTCONFIG_FILE=/home/walker/.config/orca-slicer/fonts.conf orca-slicer %U
Terminal=false
Type=Application
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
MimeType=model/stl;application/sla;model/3mf;application/zip;application/octet-stream;application/vnd.ms-3mfdocument;application/prs.wavefront-obj;application/x-amf;model/step;x-scheme-handler/orcaslicer;x-scheme-handler/bambu-studio;x-scheme-handler/bambulab;x-scheme-handler/makerworld;x-scheme-handler/bambustudio;x-scheme-handler/prusaslicer;
Categories=Graphics;3DGraphics;Engineering;
Keywords=3D;Printing;Slicer;slice;3D;printer;convert;gcode;stl;obj;amf;
StartupNotify=true
StartupWMClass=orca-slicer
