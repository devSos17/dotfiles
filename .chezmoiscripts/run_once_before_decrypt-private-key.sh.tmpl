#!/bin/sh

# Modo prueba/VM (bootstrap.sh NO_SECRETS=1): no hay passphrase disponible,
# saltar el decrypt en vez de colgarse esperando input.
if [ -f "${HOME}/.config/chezmoi/no-secrets" ]; then
    echo ":: no-secrets: saltando decrypt de la age key"
    exit 0
fi

if [ ! -f "${HOME}/.config/chezmoi/key.txt" ]; then
    mkdir -p "${HOME}/.config/chezmoi"
    chezmoi age decrypt --output "${HOME}/.config/chezmoi/key.txt" --passphrase "{{ .chezmoi.sourceDir }}/key.txt.age"
    chmod 600 "${HOME}/.config/chezmoi/key.txt"
fi
