#!/usr/bin/env bash
# chezmoi run_once -> instala paquetes de common + <hostname> desde
# .chezmoidata/packages.yaml. chezmoi renderiza este .tmpl.
set -uo pipefail

HOST="{{ .chezmoi.hostname }}"

# --- GUARD: opt-in explicito por maquina ---
# Este script instala ~190 paquetes. NO debe dispararse solo en una maquina ya
# montada solo porque corriste `chezmoi apply`. Safe-by-default: no corre en
# ningun host salvo que exista el marcador.
MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/bootstrap-enabled"
if [ ! -f "$MARKER" ]; then
  echo ":: bootstrap de paquetes DESHABILITADO en '$HOST' (falta el marcador)."
  echo ":: para habilitarlo en esta maquina:  touch $MARKER"
  exit 0
fi

echo ":: bootstrap de paquetes para host: $HOST"

# --- paru (AUR helper) ---
# OJO: NO usar paru-bin ni paru-git. Son binarios precompilados contra una
# libalpm concreta; si el sistema trae una mas nueva fallan al arrancar con
# "libalpm.so.15: cannot open shared object file". El paquete `paru` compila
# contra la libalpm instalada. (Mordido en la reinstalacion de ronin, 2026-08-10.)
if ! command -v paru &>/dev/null; then
  echo ":: instalando paru (compilado desde fuente)..."
  # OJO 2: NO instalar `rust` aqui. La lista de paquetes trae `rustup`, y
  # rust/rustup son mutuamente excluyentes -> "unresolvable package conflicts"
  # y pacman aborta la transaccion ENTERA. (Mordido en ronin, 2026-08-10.)
  sudo pacman -S --needed --noconfirm base-devel git
  if ! command -v cargo &>/dev/null; then
    sudo pacman -S --needed --noconfirm rustup && rustup default stable
  fi
  tmp=$(mktemp -d)
  git clone --depth 1 https://aur.archlinux.org/paru.git "$tmp/paru"
  ( cd "$tmp/paru" && makepkg -si --noconfirm )
  rm -rf "$tmp"
fi

# --- listas (renderizadas desde .chezmoidata/packages.yaml) ---
PACMAN_PKGS=(
{{ range (index .packages "common" "pacman") }}  {{ . }}
{{ end }}{{ if (index .packages .chezmoi.hostname) }}{{ range (index .packages .chezmoi.hostname "pacman") }}  {{ . }}
{{ end }}{{ end }})

AUR_PKGS=(
{{ range (index .packages "common" "aur") }}  {{ . }}
{{ end }}{{ if (index .packages .chezmoi.hostname) }}{{ range (index .packages .chezmoi.hostname "aur") }}  {{ . }}
{{ end }}{{ end }})

echo ":: ${#PACMAN_PKGS[@]} paquetes de repo, ${#AUR_PKGS[@]} de AUR"

# Instalar en bloque. Si el bloque falla (un solo nombre invalido aborta todo
# pacman), reintentar uno por uno para aislar al culpable en vez de quedarse
# sin instalar nada.
install_batch() {
  local mgr="$1"; shift
  local pkgs=("$@")
  [ ${#pkgs[@]} -eq 0 ] && return 0
  if $mgr -S --needed --noconfirm "${pkgs[@]}"; then
    return 0
  fi
  echo ":: el bloque fallo; reintentando individualmente para aislar fallos..."
  local failed=()
  for p in "${pkgs[@]}"; do
    $mgr -S --needed --noconfirm "$p" >/dev/null 2>&1 || failed+=("$p")
  done
  if [ ${#failed[@]} -gt 0 ]; then
    echo ":: ⚠ no se pudieron instalar: ${failed[*]}"
    printf '%s\n' "${failed[@]}" > "${XDG_STATE_HOME:-$HOME/.local/state}/bootstrap-failed-pkgs.txt"
    echo ":: lista guardada en ${XDG_STATE_HOME:-$HOME/.local/state}/bootstrap-failed-pkgs.txt"
  fi
}

mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}"
install_batch "sudo pacman" "${PACMAN_PKGS[@]}"
install_batch "paru"        "${AUR_PKGS[@]}"

echo ":: paquetes listos."
echo ":: pendiente manual: habilitar servicios (docker, supergfxd) y grupos de usuario."
