{{/* gui: flag de .chezmoi.toml.tmpl (bootstrap.sh lo fija por distro).
     Maquinas viejas sin el flag en su config -> se asume true (no rompe). */}}
{{- $gui := true }}
{{- if hasKey . "gui" }}{{ $gui = .gui }}{{ end }}
{{- $secrets := true }}
{{- if hasKey . "secrets" }}{{ $secrets = .secrets }}{{ end }}
{{ if not $secrets }}
# Templates que requieren el vault — sin secretos no renderizan
.config/todoist/config.json
.config/ulauncher/ext_preferences
# Archivos age-encriptados — sin key.txt no se pueden desencriptar
# (el --exclude encrypted del init no persiste en applies posteriores)
dev/.keys
{{ end }}
{{/* Config de rbw: necesita bw_email en la config de chezmoi. Maquinas
     inicializadas antes de que existiera ese prompt -> se omite en vez de
     romper el apply. Para agregarlo:  chezmoi init  (vuelve a preguntar). */}}
{{ if not (hasKey . "bw_email") }}
.config/rbw
# Templates que llaman a rbwFields: sin rbw configurado no renderizan
.config/todoist/config.json
.config/ulauncher/ext_preferences
{{ end }}
{{/* En darwin el stack Wayland NUNCA aplica, sin importar el flag gui */}}
{{ if or (not $gui) (eq .chezmoi.os "darwin") }}
# Stack de escritorio (solo con gui=true y solo en linux)
.config/hypr
.config/kanshi
.config/waybar
.config/wlogout
.config/rofi
.config/ulauncher
.config/swappy
.config/gtk-3.0
.config/qt6ct
.config/kitty
.config/mpv
.config/zathura
.config/pika-backup
.config/nut
.config/brave-flags.conf
# Desktop entries XDG: solo tienen sentido en linux con gui.
# Sin esto, darwin crea el dir vacio aunque el .desktop de adentro este ignorado.
.local/share/applications
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# Work-only (darwin)
.config/shell/env/jira
{{ end }}
{{ if ne .chezmoi.os "linux" }}
dev
{{ end }}

{{ if ne .chezmoi.hostname "ronin" }}
# Override de Brave especifico del Optimus de ronin (LIBVA amdgpu vs nvidia)
.local/share/applications/brave-browser.desktop
{{ end }}
