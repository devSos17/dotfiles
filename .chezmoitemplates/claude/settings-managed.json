{{- /*
  Llaves de ~/.claude/settings.json que GESTIONA chezmoi: se reescriben en cada
  apply. Las llaves con valor objeto se fusionan un nivel (ej. permissions.deny
  se pisa, permissions.allow local se conserva). Ver dot_claude/modify_settings.json.tmpl.
*/ -}}
{{- $work := eq .chezmoi.hostname "C02GJ0YRQ05P" -}}
{{- $py := "/usr/bin/python3" -}}
{{- if eq .chezmoi.os "darwin" }}{{ $py = "/opt/homebrew/bin/python3" }}{{ end -}}
{
  "agent": "{{ if $work }}racker{{ else }}sos{{ end }}",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(export -p)",
      "Bash(gh auth token:*)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(aws configure export-credentials:*)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/secrets/**)",
      "Read(~/.ssh/id_*)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.local/share/chezmoi/key.txt*)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)"
    ],
    "ask": [
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.prod*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/00_repos/**)"
    ]
  },
  "claudeMdExcludes": [
    "**/00_repos/**/CLAUDE.md",
    "**/00_repos/**/.claude/**",
    "**/00_repos/**/AGENTS.md",
    "{{ .chezmoi.homeDir }}/dev/*/*-*/*/**/CLAUDE.md",
    "{{ .chezmoi.homeDir }}/dev/*/*-*/*/**/.claude/**"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $py }} -I {{ .chezmoi.homeDir }}/.claude/hooks/guard-bash.py",
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "guard-bash"
          }
        ]
      }
    ]
  }{{ if not $work }},
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "obsidian": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mauricio.wolff/mcp-obsidian@latest", "{{ .chezmoi.homeDir }}/A-Mann"]
    },
    "todoist": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@doist/todoist-ai"],
      "env": {
        "TODOIST_API_KEY": "${TODOIST_API_KEY}"
      }
    }
  }{{ end }}
}
